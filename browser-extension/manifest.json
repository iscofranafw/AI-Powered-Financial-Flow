{
  "manifest_version": 3,
  "name": "Financial Flow Local AI",
  "version": "1.0.0",
  "description": "Opt-in local Ollama assistant for Financial Flow.",
  "key": "",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:11434/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Financial Flow Local AI" },
  "content_scripts": [
    {
      "matches": ["https://shazraz.my.id/financial-flow/*"],
      "js": ["content.js"],
      "all_frames": false,
      "run_at": "document_start"
    }
  ]
}
