SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For a whole-app local development run. Staging overrides this to browser.
OLLAMA_PROVIDER=local
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b

# Staging-only browser relay. Keep the relay on VPS loopback and never expose Ollama.
# OLLAMA_PROVIDER=browser
# LOCAL_AI_BRIDGE_PORT=8511
# LOCAL_AI_ALLOWED_ORIGIN=https://shazraz.my.id
# LOCAL_AI_BRIDGE_BASE_PATH=/financial-flow/_local-ai/v1
# LOCAL_AI_BRIDGE_TIMEOUT_SECONDS=300
